{
  "name": "synapsh",
  "version": "0.1.0",
  "private": true,
  "description": "光析 - 基于 Electron 的现代化 SSH 客户端",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build && electron-builder",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@openai/codex-sdk": "^0.144.4",
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^14.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.563.0",
    "monaco-editor": "^0.55.1",
    "reka-ui": "^2.8.0",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^11.0.0",
    "vue": "v3.6.0-beta.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@iconify-json/carbon": "^1.2.18",
    "@iconify-json/lucide": "^1.2.89",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "^1.2.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.5",
    "nodemon": "^3.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "catalog:",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plus": "catalog:",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "build": {
    "appId": "com.synapsh.app",
    "productName": "SynapSH",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "productName": "SynapSH"
}
